# No real credentials. Generate isolated local values with tools/dev/bootstrap.py.
COMPOSE_PROJECT_NAME=pavlodar-gpt
DB_PORT=5433
REDIS_PORT=6381
API_PORT=8001
API_WORKERS=4
OIDC_PORT=8081
PAVLODAR_ENVIRONMENT=development
PAVLODAR_PUBLIC_ORIGIN=http://localhost:5173
PAVLODAR_COOKIE_SECURE=false
PAVLODAR_OIDC_ISSUER=http://localhost:8081/realms/pavlodar-test
PAVLODAR_OIDC_CLIENT_ID=pavlodar-web
PAVLODAR_DB_PASSWORD=
PAVLODAR_DATABASE_URL=
PAVLODAR_TOKEN_ENCRYPTION_KEY=
PAVLODAR_OIDC_CLIENT_SECRET=
PAVLODAR_UPLOAD_ROOT=.local/uploads
PAVLODAR_EXPORT_ROOT=.local/exports
# disabled | gemini | groq | openrouter. Put real keys only in ignored .env.
# Windows helper: tools/dev/configure-llm.ps1 -Provider gemini -Restart
PAVLODAR_LLM_PROVIDER=disabled
PAVLODAR_LLM_MODEL=
PAVLODAR_LLM_FALLBACK_PROVIDERS=
PAVLODAR_LLM_TIMEOUT_SECONDS=20
PAVLODAR_LLM_MAX_OUTPUT_TOKENS=800
PAVLODAR_GEMINI_MODEL=gemini-3.5-flash-lite
PAVLODAR_GEMINI_API_KEY=
PAVLODAR_GROQ_MODEL=openai/gpt-oss-20b
PAVLODAR_GROQ_API_KEY=
PAVLODAR_OPENROUTER_API_KEY=
