# Origin of the FastAPI BFF that the Vite dev/preview server proxies /v1, /auth, /health to.
PG_API_ORIGIN=http://127.0.0.1:8001

# Basemap style (MapLibre GL 6). Default: OpenFreeMap "liberty". Empty value = no external basemap
# (offline/closed profile). Keep the style's attribution (OpenFreeMap, OpenMapTiles, OpenStreetMap).
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
