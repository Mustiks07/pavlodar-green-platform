{
  "name": "pavlodar-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {"node": "22.20.0"},
  "scripts": {
    "contracts:check": "uv run python tools/spec/validate.py",
    "contracts:python": "uv run python tools/contracts/generate.py",
    "test:backend": "uv run pytest",
    "dev:api": "uv run uvicorn services.api.main:app --host 127.0.0.1 --port 8001 --no-access-log",
    "dev:web": "npm --prefix apps/web run dev",
    "check:web": "npm --prefix apps/web run typecheck",
    "test:web": "npm --prefix apps/web test"
  }
}
